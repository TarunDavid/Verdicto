# Production settings template. Copy to .env on the server and fill in every value.
SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=False
ALLOWED_HOSTS=verdicto.example.org
CSRF_TRUSTED_ORIGINS=https://verdicto.example.org
SITE_URL=https://verdicto.example.org

# Database (pip install "psycopg[binary]") and shared cache for rate limits
DATABASE_URL=postgres://verdicto:CHANGE-ME@localhost:5432/verdicto
CACHE_BACKEND=db

# Research runs in a separate worker process (Procfile "worker")
RESEARCH_MODE=worker

# AI and sources
GROQ_API_KEY=
GOOGLE_FACTCHECK_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
RESEARCH_CONTACT=https://verdicto.example.org/about

# Email for work-email codes
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Verdicto <no-reply@verdicto.example.org>

# Phone OTP at sign-up via Twilio (optional)
PHONE_OTP_ENABLED=False
SMS_BACKEND=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Accounts: use strong, unique passwords. Don't run seed_demo in production.
ADMIN_PASSWORD=
RATELIMIT_ENABLE=True
