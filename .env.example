SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000
DEMO_PASSWORD=demo-pass-2026
# Password for the seeded "admin" account (blank = same as DEMO_PASSWORD). Use a strong one if deployed.
ADMIN_PASSWORD=
RATELIMIT_ENABLE=True
# AI research. Without GROQ_API_KEY the app still runs, with keyword fallbacks.
GROQ_API_KEY=
# Each step uses a different model so the per-model token-per-minute limits are spread out.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=qwen/qwen3.8-27b
GROQ_SEARCH_MODEL=openai/gpt-oss-20b
# Optional source keys (each source is skipped when its key is empty)
GOOGLE_FACTCHECK_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Contact URL or email for the research bot's User-Agent (Wikipedia requires one)
RESEARCH_CONTACT=https://example.org/verdicto
# Ask for a 6-digit SMS code at sign-up (development: the code prints in the server log)
PHONE_OTP_ENABLED=False

# ---------- Production ----------
# DEBUG=False turns on HTTPS-only cookies, HSTS and SSL redirect.
# DATABASE_URL=postgres://user:password@localhost:5432/verdicto   (pip install "psycopg[binary]")
# CACHE_BACKEND=db            (then: python manage.py createcachetable) or redis://localhost:6379/0
# RESEARCH_MODE=worker        (then also run: python manage.py run_worker --pause 30)
# CSRF_TRUSTED_ORIGINS=https://verdicto.example.org
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST= EMAIL_PORT=587 EMAIL_HOST_USER= EMAIL_HOST_PASSWORD=
