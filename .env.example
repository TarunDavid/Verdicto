SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000
DEMO_PASSWORD=demo-pass-2026
# Password for the seeded "admin" account (blank = same as DEMO_PASSWORD). Use a strong one if deployed.
ADMIN_PASSWORD=
RATELIMIT_ENABLE=True
# AI research. Without GROQ_API_KEY the app still runs, with keyword fallbacks.
GROQ_API_KEY=
# Each step uses a different model so the per-model token-per-minute limits are spread out.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=qwen/qwen3.8-27b
GROQ_SEARCH_MODEL=openai/gpt-oss-20b
# Optional: Google Fact Check Tools API key
GOOGLE_FACTCHECK_API_KEY=
# Contact URL or email for the research bot's User-Agent (Wikipedia requires one)
RESEARCH_CONTACT=https://example.org/verdicto
