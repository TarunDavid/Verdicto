msgid "Join as a verifier"
msgstr "ಪರಿಶೀಲಕರಾಗಿ ಸೇರಿ"

msgid "Change role"
msgstr "ಪಾತ್ರ ಬದಲಿಸಿ"

msgid "YOUR EXPERTISE"
msgstr "ನಿಮ್ಮ ಪರಿಣತಿ"

msgid "Create account"
