msgid "Verifier. Review AI research and give expert verdicts that are weighted by your accuracy."
msgstr "ಪರಿಶೀಲಕ. AI ಸಂಶೋಧನೆಯನ್ನು ಪರಿಶೀಲಿಸಿ ಮತ್ತು ನಿಮ್ಮ ನಿಖರತೆಗೆ ಅನುಗುಣವಾದ ತೂಕವಿರುವ ತಜ್ಞ ತೀರ್ಪು ನೀಡಿ."

msgid "Already have an account?"
msgstr "ಈಗಾಗಲೇ ಖಾತೆ ಇದೆಯೇ?"

msgid "Create your account"
